---
// Hero image: swap the placeholder background for a real photo by
// dropping a file at src/assets/hero-camping.jpg and uncommenting
// the <img> tag below (see README "Replacing the hero photo").
---

<header class="hero">
  <!--
    <img
      src={heroImage.src}
      alt="A family relaxes outside their Grand Design travel trailer at a remote, off-grid campsite in the Colorado backcountry, mountains rising behind them at dusk."
      class="hero__photo"
    />
  -->
  <div class="hero__photo hero__photo--placeholder" role="img" aria-label="A family relaxes outside their Grand Design travel trailer at a remote, off-grid campsite in the Colorado backcountry, mountains rising behind them at dusk."></div>

  <div class="hero__scrim"></div>

  <div class="hero__arch" aria-hidden="true">
    <svg viewBox="0 0 800 220" xmlns="http://www.w3.org/2000/svg">
      <path id="archPath" d="M 60 200 A 340 340 0 0 1 740 200" fill="none" />
      <text>
        <textPath href="#archPath" startOffset="50%" text-anchor="middle">
          A&amp;E RV Solutions
        </textPath>
      </text>
    </svg>
  </div>
  <p class="hero__arch-sr">A&amp;E RV Solutions</p>

  <div class="hero__content">
    <h1 class="hero__headline">Home doesn't end at the trailhead.</h1>
    <p class="hero__subhead">
      Off-grid power, real internet, and self-contained water and
      recharging — built into your rig, so a week in the Colorado
      backcountry feels as easy as a weekend at home.
    </p>
    <a class="hero__cta" href="#capabilities">See how it works</a>
  </div>
</header>

<style>
  .hero {
    position: relative;
    min-height: 92vh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    overflow: hidden;
    isolation: isolate;
  }

  .hero__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
    z-index: -2;
  }

  /* Placeholder stand-in for the real campsite photograph.
     Evokes dusk over a Colorado ridgeline until the image is swapped in. */
  .hero__photo--placeholder {
    background:
      radial-gradient(ellipse 60% 40% at 50% 78%, rgba(232, 185, 79, 0.18), transparent 60%),
      linear-gradient(
        180deg,
        #2c3f52 0%,
        #3a5064 22%,
        #5c6f5a 46%,
        #71785a 58%,
        #3a3226 78%,
        #221c16 100%
      );
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      180deg,
      rgba(14, 21, 18, 0.55) 0%,
      rgba(14, 21, 18, 0.05) 30%,
      rgba(14, 21, 18, 0.15) 55%,
      rgba(14, 21, 18, 0.88) 100%
    );
  }

  .hero__arch {
    width: min(90%, 800px);
    margin: 3.5rem auto 0;
  }

  .hero__arch svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .hero__arch text {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 2.6rem;
    fill: var(--canvas-50);
    letter-spacing: 0.01em;
  }

  .hero__arch-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  .hero__content {
    position: relative;
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 0 1.75rem 4.5rem;
    width: 100%;
  }

  .hero__headline {
    color: var(--canvas-50);
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 400;
    line-height: 1.08;
    max-width: 18ch;
  }

  .hero__subhead {
    color: var(--sage-200);
    font-size: 1.125rem;
    max-width: 46ch;
    margin: 1.25rem 0 0;
  }

  .hero__cta {
    display: inline-block;
    margin-top: 2rem;
    padding: 0.85rem 1.75rem;
    background: var(--clay-600);
    color: var(--canvas-50);
    text-decoration: none;
    font-weight: 500;
    border-radius: 2px;
    transition: background-color 0.15s ease;
  }

  .hero__cta:hover {
    background: var(--clay-700);
  }

  @media (max-width: 640px) {
    .hero {
      min-height: 100vh;
    }
    .hero__arch text {
      font-size: 1.6rem;
    }
    .hero__arch {
      margin-top: 2.25rem;
    }
  }
</style>
