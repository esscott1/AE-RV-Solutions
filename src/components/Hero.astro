---
import { Image } from 'astro:assets';
import heroImage from '../assets/heroImage.jpg';
---

<header class="hero">
  <div class="hero__photo-frame">
    <Image
      src={heroImage}
      alt="A family relaxes outside their Grand Design travel trailer at a remote, off-grid campsite in the Colorado backcountry, mountains rising behind them at dusk."
      class="hero__photo"
      widths={[640, 960, 1440, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero__scrim"></div>

    <div class="hero__arch" aria-hidden="true">
      <svg viewBox="0 0 800 220" xmlns="http://www.w3.org/2000/svg">
        <path id="archPath" d="M 60 200 A 340 340 0 0 1 740 200" fill="none" />
        <text>
          <textPath href="#archPath" startOffset="50%" text-anchor="middle">
            A&amp;E RV Solutions
          </textPath>
        </text>
      </svg>
    </div>
    <p class="hero__arch-sr">A&amp;E RV Solutions</p>
  </div>

  <div class="hero__content">
    <h1 class="hero__headline">Home doesn't end at the trailhead.</h1>
    <p class="hero__subhead">
      Off-grid power, real internet, and self-contained water and
      recharging — built into your rig, so a week in the Colorado
      backcountry feels as easy as a weekend at home.
    </p>
    <a class="hero__cta" href="#capabilities">See how it works</a>
  </div>
</header>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .hero__photo-frame {
    position: relative;
    height: clamp(280px, 42vh, 460px);
    overflow: hidden;
    isolation: isolate;
  }

  .hero__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
    z-index: -2;
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      180deg,
      rgba(14, 21, 18, 0.45) 0%,
      rgba(14, 21, 18, 0.05) 35%,
      rgba(14, 21, 18, 0.05) 65%,
      rgba(14, 21, 18, 0.55) 100%
    );
  }

  .hero__arch {
    width: min(90%, 800px);
    margin: 2.5rem auto 0;
  }

  .hero__arch svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .hero__arch text {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 2.6rem;
    fill: var(--canvas-50);
    letter-spacing: 0.01em;
  }

  .hero__arch-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  .hero__content {
    position: relative;
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 3rem 1.75rem 4rem;
    width: 100%;
  }

  .hero__headline {
    color: var(--pine-950);
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 400;
    line-height: 1.08;
    max-width: 18ch;
  }

  .hero__subhead {
    color: var(--pine-900);
    font-size: 1.125rem;
    max-width: 46ch;
    margin: 1.25rem 0 0;
  }

  .hero__cta {
    display: inline-block;
    margin-top: 2rem;
    padding: 0.85rem 1.75rem;
    background: var(--clay-600);
    color: var(--canvas-50);
    text-decoration: none;
    font-weight: 500;
    border-radius: 2px;
    transition: background-color 0.15s ease;
  }

  .hero__cta:hover {
    background: var(--clay-700);
  }

  @media (max-width: 640px) {
    .hero__photo-frame {
      height: clamp(220px, 34vh, 340px);
    }
    .hero__arch text {
      font-size: 1.6rem;
    }
    .hero__arch {
      margin-top: 1.5rem;
    }
  }
</style>
