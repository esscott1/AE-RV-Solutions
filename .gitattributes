# Terraform config must check out with LF, even on Windows.
#
# Without this, core.autocrlf=true rewrites .tf files to CRLF on checkout.
# The Amplify build_spec is built from a heredoc in
# infrastructure/aws/modules/amplify/main.tf, so a CRLF working copy renders
# a CRLF build spec while AWS stores LF - every line then shows as changed
# in a local plan even though the content is identical. Worse, a local
# `terraform apply` from Windows would push the CRLF version and the next CI
# run (Linux, LF) would flip it straight back.
*.tf      text eol=lf
*.tfvars  text eol=lf
*.hcl     text eol=lf

# Chatbot prompts are embedded in the Step Functions definition: CRLF on a
# Windows checkout would show every line as changed in a local plan (and a
# local apply would push CRLF), exactly like the .tf case above.
infrastructure/aws/modules/*/prompts/*.md  text eol=lf

# Lambda source is zipped by archive_file, and the zip's hash decides whether
# the function's code is updated. A CRLF checkout on Windows changes the hash,
# so a local plan would show a code update CI (Linux, LF) never does.
infrastructure/aws/modules/*/lambda/**  text eol=lf
