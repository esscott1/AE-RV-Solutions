# Copy to site/.env (gitignored) for local development of the chat widget.
# Without these, the widget simply isn't rendered.
#
# Neither value is secret; production gets both from the Amplify app, set by
# Terraform. To fill them in:
#   terraform -chdir=infrastructure/aws/live/prod output -raw chat_api_url
#   terraform -chdir=infrastructure/aws/live/prod output -raw chat_api_key
# (run from the repo root, with AWS_PROFILE=OTS-Prod-Deploy)
PUBLIC_CHAT_API_URL=
PUBLIC_CHAT_API_KEY=
