# Copy to site/.env (gitignored) for local development of the chat widget.
# Without these, the widget simply isn't rendered.
#
# Neither value is secret; production gets both from the Amplify app, set by
# Terraform. To fill them in:
#   terraform -chdir=infrastructure/aws/live/prod output -raw chat_api_url
#   terraform -chdir=infrastructure/aws/live/prod output -raw chat_api_key
# (run from the repo root, with AWS_PROFILE=OTS-Prod-Deploy)
PUBLIC_CHAT_API_URL=
PUBLIC_CHAT_API_KEY=

# Employee sign-in (the /employees/ page). Without these, the page says
# sign-in isn't available. Public identifiers, not secrets; production gets
# them from the Amplify app, set by Terraform. To fill them in:
#   terraform -chdir=infrastructure/aws/live/prod output -raw employees_issuer
#   terraform -chdir=infrastructure/aws/live/prod output -raw employees_login_domain
#   terraform -chdir=infrastructure/aws/live/prod output -raw employees_client_id
#   terraform -chdir=infrastructure/aws/live/prod output -raw employees_api_url
# http://localhost:4321/employees/ is an allowed sign-in callback, so local
# sign-in works against the real user pool.
PUBLIC_COGNITO_AUTHORITY=
PUBLIC_COGNITO_DOMAIN=
PUBLIC_COGNITO_CLIENT_ID=
PUBLIC_EMPLOYEE_API_URL=
