---
// Site menu: a hamburger button (top left, in BaseLayout's top bar) that
// opens a small panel of links. A static component with a few lines of
// script, not a React island.
//
// Items marked `requires` appear only for signed-in employees in that
// Cognito group. That's display only: the pages and API check for
// themselves.
const links = [
  { href: '/', label: 'Home' },
  { href: '/testimonials/', label: 'Testimonials' },
  { href: '/employees/', label: 'Employees' },
  { href: '/ai-stats/', label: 'AI Stats', requires: 'admins' },
];

// Astro serves pages at /path/ (directory format), so normalize both sides
// before comparing.
const trim = (p: string) => p.replace(/\/+$/, '') || '/';
const current = trim(Astro.url.pathname);
---

<nav class="site-nav" aria-label="Main">
  <button
    class="site-nav__toggle"
    type="button"
    aria-expanded="false"
    aria-controls="site-nav-menu"
    aria-label="Menu"
  >
    <span class="site-nav__bar" aria-hidden="true"></span>
    <span class="site-nav__bar" aria-hidden="true"></span>
    <span class="site-nav__bar" aria-hidden="true"></span>
  </button>

  <ul class="site-nav__menu" id="site-nav-menu" hidden>
    {links.map(({ href, label, requires }) => (
      <li data-requires={requires} hidden={requires ? true : undefined}>
        <a
          class="site-nav__link"
          href={href}
          aria-current={trim(href) === current ? 'page' : undefined}
        >
          {label}
        </a>
      </li>
    ))}
  </ul>
</nav>

<script>
  // Shows signed-in items from the session oidc-client-ts keeps in
  // sessionStorage ("oidc.user:<issuer>:<client>"), read directly so public
  // pages don't load the sign-in library. auth.js announces sign-in and
  // sign-out, so the menu updates without a reload.
  function signedInGroups(): string[] {
    try {
      for (let i = 0; i < sessionStorage.length; i++) {
        const key = sessionStorage.key(i);
        if (!key?.startsWith('oidc.user:')) continue;
        const user = JSON.parse(sessionStorage.getItem(key) ?? 'null');
        if (!user?.expires_at || user.expires_at * 1000 < Date.now()) continue;
        const groups = user.profile?.['cognito:groups'];
        return Array.isArray(groups) ? groups : [];
      }
    } catch {
      // Storage blocked or unreadable: treat as signed out.
    }
    return [];
  }

  function showSignedInItems() {
    const groups = signedInGroups();
    document.querySelectorAll<HTMLLIElement>('.site-nav__menu [data-requires]').forEach((item) => {
      item.hidden = !groups.includes(item.dataset.requires ?? '');
    });
  }

  showSignedInItems();
  window.addEventListener('ae-rv-auth-change', showSignedInItems);
  // Another tab signing out doesn't share sessionStorage, but a page
  // restored from the back/forward cache should re-check.
  window.addEventListener('pageshow', showSignedInItems);

  const nav = document.querySelector<HTMLElement>('.site-nav');
  const toggle = nav?.querySelector<HTMLButtonElement>('.site-nav__toggle');
  const menu = nav?.querySelector<HTMLUListElement>('.site-nav__menu');

  if (nav && toggle && menu) {
    const setOpen = (open: boolean, returnFocus = false) => {
      toggle.setAttribute('aria-expanded', String(open));
      menu.hidden = !open;
      if (open) menu.querySelector<HTMLAnchorElement>('a')?.focus();
      else if (returnFocus) toggle.focus();
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    // Esc closes it and puts focus back on the button.
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !menu.hidden) setOpen(false, true);
    });

    // A click anywhere outside the menu closes it.
    document.addEventListener('click', (event) => {
      if (!menu.hidden && !nav.contains(event.target as Node)) setOpen(false);
    });
  }
</script>

<style>
  /* Placed by BaseLayout's top bar (top left). */
  .site-nav {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    font-family: var(--font-body);
  }

  /* 44px minimum tap target. */
  .site-nav__toggle {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 48px;
    height: 48px;
    padding: 0;
    border: 0;
    border-radius: 10px;
    background: var(--pine-950);
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(14, 21, 18, 0.25);
    transition: background-color 0.15s ease;
  }

  .site-nav__toggle:hover {
    background: var(--pine-900);
  }

  .site-nav__bar {
    display: block;
    width: 22px;
    height: 2px;
    border-radius: 2px;
    background: var(--canvas-50);
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  /* The three bars become an X while the menu is open. */
  .site-nav__toggle[aria-expanded='true'] .site-nav__bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .site-nav__toggle[aria-expanded='true'] .site-nav__bar:nth-child(2) {
    opacity: 0;
  }

  .site-nav__toggle[aria-expanded='true'] .site-nav__bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .site-nav__menu {
    min-width: 12rem;
    margin: 0;
    padding: 0.4rem;
    list-style: none;
    background: var(--canvas-50);
    border: 1px solid var(--sage-200);
    border-radius: 12px;
    box-shadow: 0 12px 32px rgba(14, 21, 18, 0.22);
  }

  .site-nav__menu[hidden],
  .site-nav__menu li[hidden] {
    display: none;
  }

  .site-nav__link {
    display: block;
    min-height: 44px;
    padding: 0.65rem 0.9rem;
    border-radius: 8px;
    color: var(--pine-950);
    font-weight: 500;
    text-decoration: none;
  }

  .site-nav__link:hover {
    background: var(--canvas-100);
  }

  .site-nav__link[aria-current='page'] {
    color: var(--clay-700);
    font-weight: 600;
  }
</style>
