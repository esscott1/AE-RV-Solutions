---
import { Image } from 'astro:assets';
import heroImage from '../assets/heroImage.jpg';
---

<header class="hero">
  <div class="hero__photo-frame">
    <Image
      src={heroImage}
      alt="A family relaxes outside their Grand Design travel trailer at a remote, off-grid campsite in the Colorado backcountry, mountains rising behind them at dusk."
      class="hero__photo"
      widths={[640, 928, 1392, 1856]}
      sizes="80vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero__scrim"></div>

    <div class="hero__arch" aria-hidden="true">
      <svg viewBox="0 0 800 220" xmlns="http://www.w3.org/2000/svg">
        <path id="archPath" d="M 60 200 A 340 340 0 0 1 740 200" fill="none" />
        <text>
          <textPath href="#archPath" startOffset="50%" text-anchor="middle">
            A&amp;E RV Solutions
          </textPath>
        </text>
      </svg>
    </div>
    <p class="hero__arch-sr">A&amp;E RV Solutions</p>
  </div>

  <div class="hero__content">
    <h1 class="hero__headline">Home doesn't end at the trailhead.</h1>
    <p class="hero__subhead">
      Off-grid power, real internet, and self-contained water and
      recharging — built into your rig, so a week in the Colorado
      backcountry feels as easy as a weekend at home.
    </p>
    <a class="hero__cta" href="#capabilities">See how it works</a>
  </div>
</header>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .hero__photo-frame {
    position: relative;
    /* The photo is 80% of the viewport and shrinks with it. No fixed height:
       the frame takes its height from the image itself, so the full frame is
       always shown at its native aspect ratio and nothing is ever cropped. */
    width: var(--content-width);
    margin-inline: auto;
    isolation: isolate;
  }

  .hero__photo {
    display: block;
    width: 100%;
    height: auto;
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      180deg,
      rgba(14, 21, 18, 0.45) 0%,
      rgba(14, 21, 18, 0.05) 35%,
      rgba(14, 21, 18, 0.05) 65%,
      rgba(14, 21, 18, 0.55) 100%
    );
  }

  .hero__arch {
    /* Overlaid rather than in flow: the image now sets the frame's height,
       so an in-flow arch would stack below it instead of sitting on it. */
    position: absolute;
    inset-inline: 0;
    top: 2.5rem;
    z-index: 2;
    width: min(90%, 800px);
    margin-inline: auto;
  }

  .hero__arch svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .hero__arch text {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 2.6rem;
    fill: var(--canvas-50);
    letter-spacing: 0.01em;
  }

  .hero__arch-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  .hero__content {
    position: relative;
    /* Horizontal padding stays at 0 so the column's own edges - not padding
       inside a wider box - are what line up with the photo above. */
    width: var(--content-width);
    margin-inline: auto;
    padding: 3rem 0 4rem;
  }

  .hero__headline {
    color: var(--pine-950);
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 400;
    line-height: 1.08;
    max-width: 18ch;
  }

  .hero__subhead {
    color: var(--pine-900);
    font-size: 1.125rem;
    max-width: 46ch;
    margin: 1.25rem 0 0;
  }

  .hero__cta {
    display: inline-block;
    margin-top: 2rem;
    padding: 0.85rem 1.75rem;
    background: var(--clay-600);
    color: var(--canvas-50);
    text-decoration: none;
    font-weight: 500;
    border-radius: 2px;
    transition: background-color 0.15s ease;
  }

  .hero__cta:hover {
    background: var(--clay-700);
  }

  @media (max-width: 640px) {
    .hero__arch text {
      font-size: 1.6rem;
    }
    .hero__arch {
      top: 1.5rem;
    }
  }
</style>
