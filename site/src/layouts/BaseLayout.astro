---
import '../styles/global.css';
import ChatWidget from '../components/ChatWidget.jsx';
import SiteNav from '../components/SiteNav.astro';
import AccountMenu from '../components/AccountMenu.jsx';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  // Keeps a page out of search results (e.g. the employee sign-in page).
  noindex?: boolean;
  // Shows the signed-in employee's account menu (top right), for pages
  // behind sign-in.
  account?: boolean;
}

const {
  title,
  description = 'A&E RV Solutions — off-grid power, connectivity, and self-sufficient systems for your travel trailer.',
  noindex = false,
  account = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <title>{title}</title>
  </head>
  <body>
    <!-- Top bar: menu on the left, the account menu (signed-in pages) on the
         right, like the AWS console. It scrolls with the page and sits below
         the chat window in the stacking order. -->
    <header class="site-header">
      <SiteNav />
      {account && <AccountMenu client:load />}
    </header>
    <slot />
    <Footer />
    <!-- Loads React only once the browser is idle, so it never delays first
         paint. The widget checks whether chat is switched on when it's
         opened, not on page load. -->
    <ChatWidget client:idle />
  </body>
</html>

<style>
  .site-header {
    position: absolute;
    top: 1rem;
    left: 1rem;
    right: 1rem;
    z-index: 40;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    /* The bar spans the page, but only its buttons take clicks: the hero
       photo underneath stays clickable. */
    pointer-events: none;
  }

  .site-header > :global(*) {
    pointer-events: auto;
  }
</style>
