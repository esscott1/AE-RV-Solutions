---
import '../styles/global.css';
import ChatWidget from '../components/ChatWidget.jsx';
import SiteNav from '../components/SiteNav.astro';
import AccountMenu from '../components/AccountMenu.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  // Keeps a page out of search results (e.g. the employee sign-in page).
  noindex?: boolean;
}

const {
  title,
  description = 'A&E RV Solutions — off-grid power, connectivity, and self-sufficient systems for your travel trailer.',
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <title>{title}</title>
  </head>
  <body>
    <!-- Navigation banner above the page: the site menu (public pages +
         Employees) on the left and, while an employee is signed in, their
         account menu (employee pages + Sign out) on the right, like the AWS
         console. It sits below the chat window in the stacking order. -->
    <header class="site-header">
      <SiteNav />
      <AccountMenu />
    </header>
    <slot />
    <Footer />
    <!-- Loads React only once the browser is idle, so it never delays first
         paint. The widget checks whether chat is switched on when it's
         opened, not on page load. -->
    <ChatWidget client:idle />
  </body>
</html>

<style>
  .site-header {
    position: relative;
    z-index: 40;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 50px;
    padding: 0 0.75rem;
    background: var(--pine-950);
    color: var(--canvas-50);
  }
</style>
