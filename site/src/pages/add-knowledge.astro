---
import BaseLayout from '../layouts/BaseLayout.astro';
import AddKnowledge from '../components/AddKnowledge.jsx';
---

<!-- Add Knowledge: a public shell. Everything shown comes from the employee API's
     knowledge routes, which require sign-in (and the admins group where
     noted in modules/employees/lambda/kb.py). -->
<BaseLayout title="Add Knowledge | A&E RV Solutions" description="Submit knowledge for Eddie." noindex>
  <main class="page">
    <AddKnowledge client:load />
  </main>
</BaseLayout>

<style>
  .page {
    width: var(--content-width);
    max-width: 60rem;
    min-height: 70vh;
    margin-inline: auto;
    padding: 2.5rem 0 4rem;
  }
</style>
