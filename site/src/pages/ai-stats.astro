---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdminPanel from '../components/AdminPanel.jsx';
---

<!-- AI Stats (admins only). A public shell, like /employees/: nothing protected is in this page.
     Usage and conversations come from the employee API's admin routes,
     which only answer members of the Cognito admins group
     (infrastructure/aws/modules/employees). -->
<BaseLayout title="AI Stats | A&E RV Solutions" description="Eddie's usage and conversations." noindex>
  <main class="page">
    <AdminPanel client:load />
  </main>
</BaseLayout>

<style>
  .page {
    width: var(--content-width);
    max-width: 72rem;
    min-height: 70vh;
    margin-inline: auto;
    padding: 6rem 0 4rem;
  }
</style>
