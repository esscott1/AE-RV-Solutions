---
import BaseLayout from '../layouts/BaseLayout.astro';
import KBViewer from '../components/KBViewer.jsx';
---

<!-- KBViewer: a public shell. Everything shown comes from the employee API's
     knowledge routes, which require sign-in (and the admins group where
     noted in modules/employees/lambda/kb.py). -->
<BaseLayout title="KBViewer | A&E RV Solutions" description="Everything Eddie knows." noindex>
  <main class="page">
    <KBViewer client:load />
  </main>
</BaseLayout>

<style>
  .page {
    width: var(--content-width);
    max-width: 60rem;
    min-height: 70vh;
    margin-inline: auto;
    padding: 2.5rem 0 4rem;
  }
</style>
